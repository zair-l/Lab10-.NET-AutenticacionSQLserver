@model University.Models.Course
@{ ViewBag.Title = "Eliminar curso"; }
<h1>Eliminar curso</h1><p class="lead">Confirma la eliminación de este registro.</p>
<div class="panel">@Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })<dl class="details"><dt>@Html.DisplayNameFor(m => m.Title)</dt><dd>@Html.DisplayFor(m => m.Title)</dd><dt>@Html.DisplayNameFor(m => m.Credits)</dt><dd>@Html.DisplayFor(m => m.Credits)</dd></dl>@using (Html.BeginForm()) { @Html.AntiForgeryToken() <div class="actions"><button class="btn btn-danger" type="submit">Eliminar curso</button>@Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })</div> }</div>

