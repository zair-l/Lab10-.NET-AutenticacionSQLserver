@model University.Models.Student
@{ ViewBag.Title = "Nuevo estudiante"; }
<h1>Nuevo estudiante</h1><p class="lead">Registra al estudiante y, si corresponde, su correo electrónico.</p>
<div class="panel form-grid">@using (Html.BeginForm()) { @Html.AntiForgeryToken() @Html.Partial("_Form", Model) <div class="actions"><button class="btn" type="submit">Guardar estudiante</button>@Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })</div> }</div>
@section scripts { <script src="~/Scripts/jquery.validate.min.js"></script><script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script> }
