@model University.Models.Student
@Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })
<div class="field">@Html.LabelFor(m => m.LastName) @Html.TextBoxFor(m => m.LastName, new { @class = "input", maxlength = "50", autocomplete = "family-name" }) @Html.ValidationMessageFor(m => m.LastName)</div>
<div class="field">@Html.LabelFor(m => m.FirstName) @Html.TextBoxFor(m => m.FirstName, new { @class = "input", maxlength = "50", autocomplete = "given-name" }) @Html.ValidationMessageFor(m => m.FirstName)</div>
<div class="field">@Html.LabelFor(m => m.EnrollmentDate) @Html.TextBoxFor(m => m.EnrollmentDate, "{0:yyyy-MM-dd}", new { @class = "input", type = "date" }) @Html.ValidationMessageFor(m => m.EnrollmentDate)</div>
<div class="field">@Html.LabelFor(m => m.Email) @Html.TextBoxFor(m => m.Email, new { @class = "input", type = "email", maxlength = "254", autocomplete = "email" }) @Html.ValidationMessageFor(m => m.Email)</div>
