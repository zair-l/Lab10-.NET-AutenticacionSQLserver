@model University.Models.Enrollment
@Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })
<div class="field">@Html.LabelFor(m => m.StudentID) @Html.DropDownList("StudentID", null, "Selecciona un estudiante", new { @class = "input" }) @Html.ValidationMessageFor(m => m.StudentID)</div>
<div class="field">@Html.LabelFor(m => m.CourseID) @Html.DropDownList("CourseID", null, "Selecciona un curso", new { @class = "input" }) @Html.ValidationMessageFor(m => m.CourseID)</div>
<div class="field">@Html.LabelFor(m => m.Grade) @Html.TextBoxFor(m => m.Grade, "{0:0.00}", new { @class = "input grade-input", type = "text", inputmode = "decimal", autocomplete = "off", placeholder = "Deja vacío si aún no tiene nota" }) @Html.ValidationMessageFor(m => m.Grade)</div>
<script>
    (function () {
        var gradeInput = document.querySelector(".grade-input");
        if (!gradeInput) return;

        function formatGrade() {
            var raw = gradeInput.value.trim();
            if (!raw) return;

            var value = Number(raw.replace(",", "."));
            if (Number.isFinite(value)) gradeInput.value = value.toFixed(2);
        }

        gradeInput.addEventListener("blur", formatGrade);
        if (gradeInput.form) gradeInput.form.addEventListener("submit", formatGrade);
    })();
</script>
