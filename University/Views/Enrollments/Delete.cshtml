@model University.Models.Enrollment
@{ ViewBag.Title = "Eliminar matrícula"; }
<h1>Eliminar matrícula</h1><p class="lead">Confirma la eliminación de esta matrícula.</p>
<div class="panel"><dl class="details"><dt>Estudiante</dt><dd>@Model.Student.LastName, @Model.Student.FirstName</dd><dt>Curso</dt><dd>@Model.Course.Title</dd><dt>Nota</dt><dd>@(Model.Grade.HasValue ? Model.Grade.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "Pendiente")</dd></dl>@using (Html.BeginForm()) { @Html.AntiForgeryToken() <div class="actions"><button class="btn btn-danger" type="submit">Eliminar matrícula</button>@Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })</div> }</div>
